<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-Job: täglicher Staffing-ETL-Lauf um 00:00.

  Installation (siehe scripts/README.md):
    cp scripts/com.staffing.etl.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.staffing.etl.plist

  Hinweis: Der absolute Pfad unten ist auf dieses Projekt gesetzt. Wenn das
  Repo verschoben wird, Pfade hier und die StandardOut/Error-Pfade anpassen.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.staffing.etl</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/wladislawsaydullaev/Documents/UNI/Semester 6/projekt_ba/project_bba_repo/staffing_project_bba/scripts/run_etl.sh</string>
    </array>

    <!-- Täglich um 00:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Falls der Mac um 00:00 aus war: Lauf beim nächsten Hochfahren nachholen -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/wladislawsaydullaev/Documents/UNI/Semester 6/projekt_ba/project_bba_repo/staffing_project_bba/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wladislawsaydullaev/Documents/UNI/Semester 6/projekt_ba/project_bba_repo/staffing_project_bba/logs/launchd.err.log</string>
</dict>
</plist>
